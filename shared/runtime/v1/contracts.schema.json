{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clau:runtime:1.0.0",
  "title": "CLAU Hospitality Runtime contracts v1.0.0 (For Review; not active in backend)",
  "description": "Select a $defs contract explicitly. Root intentionally rejects untyped payloads.",
  "not": {},
  "$defs": {
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "fact_sheet",
            "voice_card",
            "brief",
            "campaign",
            "asset",
            "approved_content",
            "tool_result"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted"
          ]
        }
      },
      "required": [
        "client_code",
        "source_type",
        "source_id",
        "source_version",
        "content_sha256",
        "retrieved_at",
        "sensitivity"
      ]
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "constitution",
            "boundary",
            "rule",
            "skill",
            "persona",
            "voice_guide",
            "humanize_guide",
            "vertical",
            "platform",
            "calendar",
            "prompt_template",
            "output_schema",
            "validator_config",
            "tool_contract",
            "escalation_rules"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*(?:\\.[a-zA-Z0-9_-]+)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ]
    },
    "VersionedItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "ModelSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "temperature_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "effort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high"
          ]
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "structured_output": {
          "const": true
        }
      },
      "required": [
        "provider",
        "model",
        "temperature_milli",
        "effort",
        "max_output_tokens",
        "structured_output"
      ]
    },
    "PromptBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "bundle_id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "bundle_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "runtime_contract_major": {
          "const": 1
        },
        "agent_id": {
          "const": "caption-writer"
        },
        "intent": {
          "const": "caption"
        },
        "autonomy_max": {
          "const": "B"
        },
        "supported_verticals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "accommodation",
              "food-beverage",
              "spa-wellness",
              "experience",
              "wedding-event",
              "travel-tour"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "supported_business_types": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "supported_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "instagram",
              "facebook",
              "tiktok",
              "google-business-profile"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "required_context": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "approved_facts",
              "voice_card",
              "brief",
              "platform",
              "format",
              "objective",
              "audience",
              "language",
              "assets"
            ]
          },
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedItem"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "validators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedItem"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "model_settings": {
          "$ref": "#/$defs/ModelSettings"
        }
      },
      "required": [
        "contract_version",
        "bundle_id",
        "bundle_version",
        "runtime_contract_major",
        "agent_id",
        "intent",
        "autonomy_max",
        "supported_verticals",
        "supported_business_types",
        "supported_channels",
        "required_context",
        "components",
        "tools",
        "validators",
        "model_settings"
      ]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "category": {
          "type": "string",
          "enum": [
            "facility",
            "location",
            "price",
            "rating",
            "certification",
            "halal-dietary",
            "food-beverage",
            "treatment",
            "capacity",
            "safety",
            "license",
            "itinerary",
            "experience",
            "other"
          ]
        },
        "fact_key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+\\.[a-z0-9]+([._-][a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "implied": {
          "type": "boolean"
        },
        "variant_indexes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "text",
        "category",
        "fact_key",
        "implied",
        "variant_indexes"
      ]
    },
    "AltText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "asset_id",
        "text"
      ]
    },
    "Variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "storytelling",
            "informative",
            "conversational"
          ]
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^#[^\\s#]+$"
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "alt_texts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AltText"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "language": {
          "type": "string",
          "enum": [
            "id",
            "en"
          ]
        }
      },
      "required": [
        "style",
        "hook",
        "body",
        "cta",
        "hashtags",
        "alt_texts",
        "language"
      ]
    },
    "TaraGeneration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "clarification_required",
            "escalation_required"
          ]
        },
        "clarification_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "suggested_content_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "price_promo",
              "people",
              "ota_listing",
              "negative_review",
              "paid_ads",
              "influencer",
              "religion_culture",
              "crisis"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "model_notes_for_reviewer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "contract_version",
        "status",
        "clarification_questions",
        "variants",
        "claims",
        "missing_information",
        "suggested_content_flags",
        "model_notes_for_reviewer"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "variants": {
                "minItems": 3
              },
              "clarification_questions": {
                "maxItems": 0
              },
              "missing_information": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "clarification_required"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "clarification_questions": {
                "minItems": 1
              },
              "variants": {
                "maxItems": 0
              },
              "claims": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "escalation_required"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "model_notes_for_reviewer": {
                "minItems": 1
              },
              "variants": {
                "maxItems": 0
              },
              "claims": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "MemoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "client_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "memory_type": {
          "type": "string",
          "enum": [
            "approved_fact",
            "voice_card",
            "brand_restriction",
            "terminology",
            "profile",
            "audience",
            "recurring_cta",
            "asset_rights",
            "campaign",
            "working",
            "historical_reference"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "superseded",
            "revoked"
          ]
        },
        "source": {
          "$ref": "#/$defs/Provenance"
        },
        "evidence_label": {
          "type": "string",
          "enum": [
            "DATA FINAL",
            "ASSUMPTION",
            "CLIENT CONFIRMATION",
            "FIELD VERIFICATION",
            "RISK",
            "NEXT ACTION"
          ]
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted"
          ]
        }
      },
      "required": [
        "contract_version",
        "memory_id",
        "client_code",
        "memory_type",
        "value",
        "status",
        "source",
        "evidence_label",
        "approved_by",
        "approved_at",
        "valid_from",
        "valid_until",
        "version",
        "superseded_by",
        "sensitivity"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "superseded_by": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "superseded_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "memory_type": {
                "const": "approved_fact"
              },
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_label": {
                "const": "DATA FINAL"
              },
              "source": {
                "properties": {
                  "source_type": {
                    "const": "fact_sheet"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ToolContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "allowed_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "allowed_intents": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "input_schema_component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "output_schema_component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "client_scope": {
          "const": "server_bound"
        },
        "side_effects": {
          "const": "read_only"
        },
        "sensitivity_max": {
          "type": "string",
          "enum": [
            "Public",
            "Internal",
            "Confidential"
          ]
        },
        "audit": {
          "const": "metadata_only"
        },
        "error_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "provider_error",
              "provider_unavailable",
              "refused",
              "invalid_output",
              "budget_exceeded",
              "request_closed",
              "fact_sheet_missing",
              "worker_timeout",
              "ai_disabled",
              "cancelled_by_user",
              "bundle_missing",
              "bundle_invalid",
              "bundle_incompatible",
              "context_missing",
              "stale_context",
              "tenant_scope_violation",
              "restricted_data",
              "asset_rights_missing",
              "tool_not_allowed",
              "tool_timeout",
              "tool_invalid_output",
              "validation_failed",
              "lease_lost"
            ]
          },
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true
        }
      },
      "required": [
        "contract_version",
        "name",
        "version",
        "allowed_agents",
        "allowed_intents",
        "input_schema_component",
        "output_schema_component",
        "timeout_ms",
        "max_result_bytes",
        "client_scope",
        "side_effects",
        "sensitivity_max",
        "audit",
        "error_codes"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "owner_role": {
          "type": "string",
          "enum": [
            "owner",
            "content_lead",
            "content_staff",
            "client_approver"
          ]
        },
        "resolved": {
          "type": "boolean"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "description",
        "owner_role",
        "resolved",
